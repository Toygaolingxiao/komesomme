{
  "name": "komesomme",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca next dev --turbopack",
    "build": "cross-env NODE_OPTIONS=--use-system-ca next build",
    "start": "cross-env NODE_OPTIONS=--use-system-ca next start",
    "lint": "eslint src scripts --cache --cache-location .next/cache/eslint/.eslintcache",
    "typecheck": "tsc --noEmit",
    "validate:rice": "node --import tsx scripts/validate-rice-profiles.ts",
    "assert:client-bundle": "node --import tsx scripts/assert-client-bundle.ts",
    "seed:rice": "node --use-system-ca --import tsx scripts/seed-rice-profiles.ts",
    "rakuten:item": "node --use-system-ca --import tsx scripts/resolve-rakuten-items.ts",
    "inventory:audit": "node --use-system-ca --import tsx scripts/audit-shop-inventory.ts",
    "encyclopedia:generate": "node --use-system-ca --import tsx scripts/generate-rice-encyclopedia.ts",
    "encyclopedia:audit": "node --import tsx scripts/audit-encyclopedia-vs-catalog.ts",
    "brand-art:optimize": "node --import tsx scripts/optimize-brand-art.ts",
    "brand-art:sync-prefs": "node --import tsx scripts/sync-prefecture-art-ids.ts",
    "yahoo:sync": "node --use-system-ca --import tsx scripts/sync-yahoo-affiliate-links.ts",
    "yahoo:sync:furusato": "node --use-system-ca --import tsx scripts/sync-yahoo-affiliate-links.ts --furusato",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:report": "node --import tsx scripts/write-test-report.ts",
    "test": "npm run test:unit && npm run test:e2e && npm run test:report"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.73.0",
    "@supabase/supabase-js": "^2.49.8",
    "cross-env": "^10.1.0",
    "dotenv": "^16.5.0",
    "motion": "^13.1.1",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
