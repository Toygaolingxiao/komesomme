# `.env.local` にコピーして使用してください。秘密情報はGitにコミットしないでください。
# 本番環境設定ダッシュボード: docs/vercel-production.md

# --- サイト基本設定 (ローカルでは任意。本番環境で canonical / OG / sitemap に使用) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase 設定 (必須) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Embeddings 設定 (いずれか1つを選択。変更時は `npm run seed:rice` の実行が必要) ---
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=
# 銘柄ライブラリ生成の既定は gemini-3.5-flash-lite → 3.1-flash-lite → 3.5-flash
# ENCYCLOPEDIA_GEMINI_MODEL=gemini-3.5-flash-lite
# 相談返事は 3.5-flash 優先（枠切れ時 Lite）。上書き: SOMMELIER_GEMINI_MODEL=gemini-3.5-flash

# --- 診断・相談 API 設定 (未設定の場合はデフォルト値が使用されます) ---
SEMANTIC_RECOMMEND_ENABLED=true
# SEMANTIC_RATE_LIMIT_PER_MIN=8
# SEMANTIC_RATE_LIMIT_PER_DAY=80

# --- 一键分享卡（默认关闭。完成度不足时先关；试用时打开 NEXT_PUBLIC_）---
# NEXT_PUBLIC_SHARE_CARD_ENABLED=1
# SHARE_CARD_ENABLED=1

# --- 楽天市場 (任意。APIキーなしの場合はキーワード検索になります) ---
# アプリ作成: https://webservice.rakuten.co.jp/app/list
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=
NEXT_PUBLIC_RAKUTEN_AFFILIATE_ID=
# 登録済み本番メディアでのみアフィ包装。Vercel Production は自動。Preview には ID を置かない。
# RAKUTEN_AFFILIATE_WRAP=1

# --- Amazon アソシエイト / PA-API ---
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=takae03-22
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=takae03-22

# メルカリアンバサダー（検索結果 URL の afid）。Web ツールバーで発行した ID。
NEXT_PUBLIC_MERCARI_AFID=7137822833

# --- Yahoo!ショッピング ---
# Yahoo! JAPAN デベロッパーネットワークの クライアントID (アプリケーションID)
YAHOO_CLIENT_ID=
# 通販 CTA は DB の公式短鎖（yahoo_shopping_affiliate_links）またはプレーン検索。
# ValueCommerce は採用しない（YAHOO_VC_* / VALUE_COMMERCE_WRAP は無効化済み）。

# --- さとふる (ふるさと納税。プレーン検索 URL) ---
SATOFULL_SEARCH_BASE_URL=https://www.satofull.jp/products/list.php?q=

# --- 購入 CTA（お店で探す）。未設定 = 表示。隠すときだけ 0 ---
# NEXT_PUBLIC_SHOP_LINKS_ENABLED=0
# SHOP_LINKS_ENABLED=0

# --- アクセス解析・ログ ---
ACCESS_LOG_ENABLED=true
# 本机 localhost / 已登录观测台的同一浏览器 不会写入。Preview 部署也不写。
# GTM は任意。GA4 を gtag 直连しているときは空のまま（二重計測を避ける）。
# NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-YS0M3YF38P
# Sentry（可选。未设则 SDK 不上报）。DSN 本来就会进浏览器，不是密钥。
# NEXT_PUBLIC_SENTRY_DSN=
# 上传 source map 时才需要（CI / Vercel）。没有也能报错，只是栈难看。
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# --- 内部观测台 /ops（任意。未设置或短于 16 字符时整面 404，不出现在导航）---
# 仅 Production / 本机。勿写入 NEXT_PUBLIC_*。浏览器只持有签名 cookie。
# 真实值只放 `.env.local` 和 Vercel Production，不要写进本文件。
# OPS_DASHBOARD_SECRET=
