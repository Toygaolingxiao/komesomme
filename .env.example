# KomeSomme — environment template
# Copy to `.env.local` and fill in real values. Never commit secrets.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Embedding provider: "gemini" (default) or "openai".
# Both produce 1536 dimensions, but vectors from different models are not
# comparable — changing this requires re-running `npm run seed:rice`.
EMBEDDING_PROVIDER=gemini

# Needed when EMBEDDING_PROVIDER=gemini (gemini-embedding-001)
GEMINI_API_KEY=

# Needed when EMBEDDING_PROVIDER=openai (text-embedding-3-small)
OPENAI_API_KEY=
