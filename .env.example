# Copy to `.env.local`. Never commit secrets.
# Production dashboard: docs/vercel-production.md

# --- Site (optional locally; set on Production for canonical / OG / sitemap) ---
NEXT_PUBLIC_SITE_URL=

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Embeddings (one provider). Changing provider requires `npm run seed:rice`. ---
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=

# --- Consultation API (omit to use defaults) ---
SEMANTIC_RECOMMEND_ENABLED=true
# SEMANTIC_RATE_LIMIT_PER_MIN=8
# SEMANTIC_RATE_LIMIT_PER_DAY=80

# --- Analytics ---
ACCESS_LOG_ENABLED=true
# NEXT_PUBLIC_GTM_ID=
