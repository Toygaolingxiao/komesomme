# KomeSomme — environment template
# Copy to `.env.local` and fill in real values. Never commit secrets.

# Public site origin (canonical URLs / OG / sitemap). No trailing slash.
# Production example: https://komesomme.vercel.app  or the custom domain.
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Embedding provider: "gemini" (default) or "openai".
# Both produce 1536 dimensions, but vectors from different models are not
# comparable — changing this requires re-running `npm run seed:rice`.
EMBEDDING_PROVIDER=gemini

# Needed when EMBEDDING_PROVIDER=gemini (gemini-embedding-001)
GEMINI_API_KEY=

# Needed when EMBEDDING_PROVIDER=openai (text-embedding-3-small)
OPENAI_API_KEY=

# Consultation API protection (public Vercel URLs).
# Set to false/0/off to hard-disable embedding + LLM calls.
SEMANTIC_RECOMMEND_ENABLED=true
# Best-effort per-IP limits (per serverless isolate). Defaults: 8/min, 80/day.
SEMANTIC_RATE_LIMIT_PER_MIN=8
SEMANTIC_RATE_LIMIT_PER_DAY=80

# Analytics (optional).
# GTM container ID — leave empty to skip the script. Wire GA4 inside GTM.
# NEXT_PUBLIC_GTM_ID=GTM-XXXX
# Anonymous access_events to Supabase via /api/analytics/event (default on).
ACCESS_LOG_ENABLED=true

# Affiliate tags — fill when accounts are ready (weekend). Optional until then.
# RAKUTEN_AFFILIATE_ID=
# AMAZON_ASSOCIATE_TAG=
