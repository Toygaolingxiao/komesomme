# `.env.local` にコピーして使用してください。秘密情報はGitにコミットしないでください。
# 本番環境設定ダッシュボード: docs/vercel-production.md

# --- サイト基本設定 (ローカルでは任意。本番環境で canonical / OG / sitemap に使用) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase 設定 (必須) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Embeddings 設定 (いずれか1つを選択。変更時は `npm run seed:rice` の実行が必要) ---
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=
# 銘柄ライブラリ生成の既定は gemini-3.5-flash-lite → 3.1-flash-lite → 3.5-flash
# ENCYCLOPEDIA_GEMINI_MODEL=gemini-3.5-flash-lite
# 相談返事は 3.5-flash 優先（枠切れ時 Lite）。上書き: SOMMELIER_GEMINI_MODEL=gemini-3.5-flash

# --- 診断・相談 API 設定 (未設定の場合はデフォルト値が使用されます) ---
SEMANTIC_RECOMMEND_ENABLED=true
# SEMANTIC_RATE_LIMIT_PER_MIN=8
# SEMANTIC_RATE_LIMIT_PER_DAY=80

# --- 楽天市場 (任意。APIキーなしの場合はキーワード検索になります) ---
# アプリ作成: https://webservice.rakuten.co.jp/app/list
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=
NEXT_PUBLIC_RAKUTEN_AFFILIATE_ID=
# 登録済み本番メディアでのみアフィ包装。Vercel Production は自動。Preview には ID を置かない。
# RAKUTEN_AFFILIATE_WRAP=1

# --- Amazon アソシエイト / PA-API ---
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=takae03-22
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=takae03-22

# --- Yahoo!ショッピング (バリューコマース。広告主提携承認後。空なら検索 URL のまま) ---
# Yahoo! JAPAN デベロッパーネットワークの クライアントID (アプリケーションID)
YAHOO_CLIENT_ID=
YAHOO_VC_SID=
YAHOO_VC_PID=

# --- さとふる (ふるさと納税。VC 自由テキスト/MyLink。Yahoo と SID/PID が違うことが多い) ---
SATOFULL_SEARCH_BASE_URL=https://www.satofull.jp/products/list.php?q=
SATOFULL_VC_SID=
SATOFULL_VC_PID=

# 登録済み本番メディアでのみ転鎖する。Vercel Production は自動で有効。Preview には SID を置かない。
# ローカルで転鎖を試すときだけ 1（localhost が VC に未登録なら規約違反になる）
# VALUE_COMMERCE_WRAP=1

# --- アクセス解析・ログ ---
ACCESS_LOG_ENABLED=true
# 本机 localhost / 已登录观测台的同一浏览器 不会写入。Preview 部署也不写。
# NEXT_PUBLIC_GTM_ID=

# --- 内部观测台 /ops（任意。未设置或短于 16 字符时整面 404，不出现在导航）---
# 仅 Production / 本机。勿写入 NEXT_PUBLIC_*。浏览器只持有签名 cookie。
OPS_DASHBOARD_SECRET=vdE_Wj4cbSnyhawe4H
